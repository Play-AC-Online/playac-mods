{
  "$schema": "./.playac/schemas/mod.schema.json",
  "schema": 1,
  "api": 1,
  "id": "yourname.my-mod",
  "name": "My Mod",
  "version": "0.1.0",
  "authors": [
    "yourname"
  ],
  "description": "Say here what your mod does.",
  "scope": "client",
  "content": {
    "messages": "messages/en.json"
  },
  "scripts": {
    "main": "main.lua",
    "events": [
      "day_started",
      "scene_entered",
      "command_finished",
      "timer_fired"
    ]
  },
  "permissions": [
    "send_letter"
  ],
  "assets_original": true
}
